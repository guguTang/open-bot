{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Open Bot desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "allow-host-stat",
    "allow-host-ls",
    "allow-host-read",
    "allow-host-write",
    "allow-host-delete",
    "allow-host-move",
    "allow-host-open",
    "allow-host-screenshot",
    "allow-host-open-privacy",
    "allow-host-shell",
    "allow-host-click",
    "allow-host-type",
    "allow-host-key",
    "allow-host-scroll",
    "allow-host-mouse-move",
    "allow-host-drag",
    "allow-host-list-windows",
    "allow-host-ax",
    "allow-host-tcc-status",
    "allow-host-device-name",
    "allow-host-machine-id",
    "allow-host-ssh-probe",
    "allow-host-ssh-ls",
    "allow-host-ssh-read",
    "allow-host-ssh-write",
    "allow-host-ssh-delete",
    "allow-host-ssh-exec"
  ]
}
