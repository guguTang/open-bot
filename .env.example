# Go API
API_ADDR=:18080
AGENT_RUNTIME_URL=http://127.0.0.1:8001
DATABASE_URL=postgres://openbot:openbot@127.0.0.1:5432/openbot?sslmode=disable
# Agent runtime durable harness (LangGraph). RUNTIME_DURABLE=0 falls back to deprecated run_tool_loop.
RUNTIME_DURABLE=1
# Prompt-cache hint for OpenAI-compatible gateways (auto|off|blocks|key).
# auto: Anthropic/Claude→cache_control blocks; OpenAI→prompt_cache_key; else no-op.
# Unsupported fields are stripped and retried once (graceful).
# OPENBOT_PROMPT_CACHE=auto
# postgres (default) or memory (tests / no DB)
RUNTIME_CHECKPOINT=postgres
# Commit journal entries/docs via Go /internal/harness/* (0 = local graph-only tests)
RUNTIME_JOURNAL=1
# Comma-separated tools that interrupt for human approval before execute
RUNTIME_APPROVAL_TOOLS=request_secret
JWT_SECRET=open-bot-dev-jwt-secret-change-me

# Bootstrap ops platform_admin (preferred for new installs).
# On API start: if no platform_admin exists and both username+password are set,
# create that user as platform_admin of the default org (or promote existing username).
# New POST /v1/auth/register users are always "member" — never auto platform_admin.
# BOOTSTRAP_ADMIN_USERNAME=ops-admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# BOOTSTRAP_ADMIN_EMAIL=ops@example.com


# Python agent-runtime (OpenAI-compatible); also seeded as default LLM on register
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# set 1 only if upstream supports OpenAI tool calling (not plain vLLM)
OPENAI_ENABLE_TOOLS=0
# Multi-model compat (services/agent-runtime/app/model_compat.py)
# OPENAI_MODEL_FAMILY=          # openai_chat|openai_reasoning|anthropic|qwen|deepseek|compat
# OPENAI_REASONING_EFFORT=      # no-tools default; empty = omit field
# OPENAI_REASONING_EFFORT_WITH_TOOLS=none  # with tools (luna/gpt-5); empty = omit
# OPENAI_TOOL_CHOICE_AUTO=0     # 0=omit tool_choice=auto (vLLM/qwen); 1=force send

# Web / Desktop / Mobile (Vite)
# Simulator: 127.0.0.1 OK. Physical device: use LAN IP of this machine.
VITE_API_BASE=http://127.0.0.1:18080

# Optional: absolute path to skills/ (Go API lists from disk)
# SKILLS_DIR=
# OPEN_BOT_ROOT=

# Context compaction (agent-runtime; also shown in Web 设置→压缩)
# Primary trigger: estimated tokens vs model context window (per-LLM or guessed).
# Legacy max messages/chars remain as safety-net fallbacks.
COMPACT_MAX_MESSAGES=20
COMPACT_MAX_CHARS=6000
# COMPACT_KEEP_RECENT=8
# COMPACT_DEFAULT_CONTEXT_WINDOW=32768
# COMPACT_RESERVE_OUTPUT_TOKENS=2048
# COMPACT_BUDGET_RATIO=0.75


# MCP client (agent-runtime)
MCP_TIMEOUT_SECONDS=25

# Embedding (bge-m3 / OpenAI-compatible)
EMBEDDING_BASE_URL=http://192.168.5.34:30603/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# A2A adapter (optional; empty = no auth)
# A2A_TOKEN=
# A2A_PUBLIC_BASE=http://127.0.0.1:18080

# Agent-bus internal (runtime send_to_agent → Go deliver path)
OPENBOT_API_URL=http://127.0.0.1:18080
INTERNAL_TOKEN=open-bot-dev-internal
# Optional: OPENBOT_BUS_PG_FALLBACK=1  # only if API down; skips wake/WS

# Mem0 OSS (auto fact extraction + semantic recall; reuses OPENAI_*/EMBEDDING_*/DATABASE_URL)
MEM0_ENABLED=1
MEM0_COLLECTION=openbot_mem0
MEM0_TOP_K=5
MEM0_AUTO_ADD=1
# Local Dream consolidation (default on; auto after chat with rate limit)
MEM0_DREAM_ENABLED=1
# Min seconds between auto Dream runs per user (chat path); ops: make dream-user
MEM0_DREAM_INTERVAL_SECONDS=3600
# Platform Dream (opt-in; OSS runtime does not call hosted Dream API yet)
# MEM0_PLATFORM_API_KEY=
# MEM0_PLATFORM_DREAM=0
# Optional: MEM0_LLM_MODEL=  # default OPENAI_MODEL
# Optional: MEM0_LLM_PROVIDER=vllm  # or openai (openai_base_url)
# Optional: MEM0_EMBEDDING_PASS_DIMS=0  # set 1 only if embed API supports dimensions=

# Sandbox computer (Phase 1+; Docker on API host)
SANDBOX_ENABLED=1
SANDBOX_IMAGE=openbot-sandbox:dev
SANDBOX_DESKTOP_IMAGE=openbot-sandbox-desktop:dev
# Container port for noVNC (6080) or webtop (3000)
SANDBOX_DESKTOP_PORT=6080
SANDBOX_DATA_ROOT=
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
# Optional lockdown demo: SANDBOX_NETWORK_MODE=none

# bot_secrets AES-GCM (32-char raw, or any passphrase hashed to 32 bytes)
# BOT_SECRETS_KEY=dev-bot-secrets-key-change-me!!
# ENCRYPTION_KEY=  # fallback if BOT_SECRETS_KEY unset

# Routines: in-process scheduler (default on). Set 0 when using `make dev-worker`.
# ROUTINES_INPROCESS=1
# WORKER_POLL_SECONDS=30

# Langfuse v4 observability (Python agent-runtime; optional)
# Start UI: make compose-langfuse → http://localhost:3100
# Enabled when PUBLIC+SECRET set (or LANGFUSE_ENABLED=1). Soft-fails if off/missing.
# LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=pk-lf-openbot-local
LANGFUSE_SECRET_KEY=sk-lf-openbot-local-dev-change-me-not-for-prod
LANGFUSE_BASE_URL=http://127.0.0.1:3100
# Record full system prompt on open-bot.llm generations (default). Set=1 to omit bodies.
# LANGFUSE_REDACT_SYSTEM=0
# Optional cap for generation input JSON size (chars); default 48000.
# LANGFUSE_IO_TRUNCATE=48000
# UI deep links: /project/{LANGFUSE_PROJECT_ID}/traces/{traceId}
# Must match deploy/langfuse LANGFUSE_INIT_PROJECT_ID (default openbot-project).
LANGFUSE_PROJECT_ID=openbot-project
# Optional browser-facing UI origin when it differs from LANGFUSE_BASE_URL.
# LANGFUSE_PUBLIC_UI_URL=http://127.0.0.1:3100

# Casdoor OIDC (optional; dual-track with local password login)
# Start: make compose-casdoor → http://localhost:8000 (built-in/admin / 123)
# Copy Client ID/Secret from Applications → app-built-in; set Redirect URI to CASDOOR_REDIRECT_URI.
# CASDOOR_ENDPOINT=http://127.0.0.1:8000
# CASDOOR_CLIENT_ID=
# CASDOOR_CLIENT_SECRET=
# CASDOOR_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# CASDOOR_ORGANIZATION=built-in
# CASDOOR_APPLICATION=app-built-in
# Aliases also accepted: OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET / OIDC_REDIRECT_URI
